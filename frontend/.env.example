# Public browser-safe Supabase credentials (the app talks to Supabase directly)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: REST API base URL used by src/lib/api.ts (not used by the data hooks)
VITE_API_URL=https://your-project.railway.app

# MapTiler vector/raster tiles. The app falls back to OpenStreetMap when omitted.
VITE_MAPTILER_KEY=your-maptiler-key
