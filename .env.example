# ============================================
# ResQNet PostgreSQL & Backend Configuration
# ============================================

# Database Connection (PostgreSQL with PostGIS)
# Default for Docker / local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resqnet

# Backend API Port
PORT=3001

# Optional: Set if running frontend on a separate host/port from the API
# VITE_API_URL=http://localhost:3001/api

# Optional: Legacy Supabase credentials (if using Supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
