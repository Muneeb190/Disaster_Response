# Frontend environment variables (Bolt/Supabase project)
# These are pre-populated by Bolt — do not modify unless deploying independently.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend (Supabase) — used by edge functions server-side
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Optional: OpenAI or other LLM API key for AI-assisted extraction
# If not set, the deterministic keyword-based extractor is used as fallback.
# AI_EXTRACT_API_KEY=
